<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobpilot.cycle</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{ROOT}}/bin/cycle.sh</string>
  </array>
  <key>StartInterval</key><integer>10800</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>{{ROOT}}/logs/cycle.log</string>
  <key>StandardErrorPath</key><string>{{ROOT}}/logs/cycle.err.log</string>
  <key>ThrottleInterval</key><integer>600</integer>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
