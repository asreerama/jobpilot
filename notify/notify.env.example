# JobPilot phone notifications (optional but strongly recommended for
# hands-off operation). Copy this file AND notify.sh to ~/.config/jobpilot/:
#
#   mkdir -p ~/.config/jobpilot
#   cp notify/notify.sh ~/.config/jobpilot/notify.sh
#   cp notify/notify.env.example ~/.config/jobpilot/notify.env   # then edit
#
# They live in $HOME (not in the repo) so the launchd wrappers can still alert
# you when the repo's disk is unreadable — that failure is the one you most
# need to hear about.
#
# ntfy (default): free, no account. Pick a LONG RANDOM topic string — the
# topic name is the only access control. Subscribe to it in the ntfy iOS or
# Android app. Never commit it anywhere.
NOTIFY_BACKEND=ntfy
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=CHANGE_ME_long_random_string

# Or Pushcut: set NOTIFY_BACKEND=pushcut and fill these in.
# PUSHCUT_KEY=
# PUSHCUT_NOTIFICATION=JobPilot
