<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobpilot.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{ROOT}}/bin/digest.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>{{ROOT}}/logs/digest.log</string>
  <key>StandardErrorPath</key><string>{{ROOT}}/logs/digest.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
